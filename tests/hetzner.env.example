# Copy this file outside the repository or to tests/hetzner.env (gitignored),
# chmod 600 it, fill the values, then pass its path to hetzner-e2e.sh.
HCLOUD_TOKEN=
S3_ENDPOINT=fsn1.your-objectstorage.com
S3_BUCKET=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
RESTIC_PASSWORD=

# Optional test controls.
HCLOUD_LOCATION=fsn1
HCLOUD_SERVER_TYPE=cx23
TEST_IMAGES="ubuntu-24.04 debian-12"
CONTAINER_TEST_IMAGE=ubuntu-24.04
ROBUST_TEST_IMAGE=
VOLUME_EXT4_IMAGE=
VOLUME_XFS_IMAGE=
SELINUX_TEST_IMAGE=
INTERRUPTION_TEST_IMAGE=
CORRUPTION_TEST_IMAGE=
LOCK_TEST_IMAGE=
REBOOT_AFTER_RESTORE=1
WORMHOLE_S3_PREFIX=wormhole-e2e
